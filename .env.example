# =============================================================================
# Tier Zero C.O.D.E — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running docker compose.
# All variables use the TZC_ prefix to avoid conflicts with other services.
# Generate SECRET_KEY with: openssl rand -base64 32
# =============================================================================

# --- Django Settings (required) ---
TZC_SECRET_KEY=           # Required. Generate with: openssl rand -base64 32
TZC_DEBUG=False
TZC_DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database Settings (required) ---
TZC_DATABASE_NAME=dockerdjango
TZC_DATABASE_USER=         # Required. Choose a database username.
TZC_DATABASE_PASSWORD=     # Required. Choose a strong database password.
TZC_DATABASE_PORT=5432
TZC_DATABASE_ENGINE=postgresql_psycopg2

# --- Redis Settings ---
TZC_REDIS_PORT=6379
TZC_REDIS_DB=0

# --- Web Server Settings ---
TZC_GUNICORN_WORKERS=3
TZC_WEB_PORT=8000

# --- HTTPS / SSL ---
# Set to True when running behind an SSL-terminating reverse proxy (nginx, Traefik, Caddy).
# Set to False if running plain HTTP (local dev, no proxy).
TZC_USE_HTTPS=True
