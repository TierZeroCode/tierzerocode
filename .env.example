# =============================================================================
# Tier Zero C.O.D.E — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running docker compose.
# Generate SECRET_KEY with: openssl rand -base64 32
# =============================================================================

# --- Django Settings (required) ---
SECRET_KEY=           # Required. Generate with: openssl rand -base64 32
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database Settings (required) ---
DATABASE_NAME=dockerdjango
DATABASE_USER=         # Required. Choose a database username.
DATABASE_PASSWORD=     # Required. Choose a strong database password.
DATABASE_PORT=5432
DATABASE_ENGINE=postgresql_psycopg2

# --- Redis Settings ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Web Server Settings ---
GUNICORN_WORKERS=3
WEB_PORT=8000

# --- HTTPS / SSL ---
# Set to True when running behind an SSL-terminating reverse proxy (nginx, Traefik, Caddy).
# Set to False if running plain HTTP (local dev, no proxy).
USE_HTTPS=True
